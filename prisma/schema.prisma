// ============================================================================
// Prisma entry point (generator + datasource only).
//
// The data model is split by domain under prisma/models/*.prisma:
//   fleet.prisma      vehicles
//   incidents.prisma  accidents, accident_media
//   admin.prisma      admin_users
//   audit.prisma      audit_logs, security_events
//   system.prisma     api_rate_limit_buckets
//
// Naming conventions (see docs/database.md):
//   - Prisma client : PascalCase models, camelCase fields  (prisma.accident.reporterName)
//   - PostgreSQL    : plural snake_case tables, snake_case columns/enums, via @@map / @map
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}
