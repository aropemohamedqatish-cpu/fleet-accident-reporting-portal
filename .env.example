DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Required: generate a random secret of at least 32 bytes; never reuse this placeholder.
JWT_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-bytes
# Used only to create/reset the initial admin; choose a unique value and change it at first login.
ADMIN_EMAIL=claims.admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
ADMIN_NAME=مدير النظام
# Public emergency contact shown to drivers. Defaults to 963966888943 if omitted.
NEXT_PUBLIC_EMERGENCY_PHONE=963966888943
INCIDENT_SUPERVISOR_1_NAME=المشرف الأول
INCIDENT_SUPERVISOR_1_PHONE=963XXXXXXXXX
INCIDENT_SUPERVISOR_2_NAME=المشرف الثاني
INCIDENT_SUPERVISOR_2_PHONE=963XXXXXXXXX
APP_HEALTH_URL=https://portal.example.com/api/health
HEALTH_ALERT_TO=operations@example.com
HEALTH_ALERT_FROM=monitor@example.com
HEALTH_SMTP_HOST=smtp.example.com
HEALTH_SMTP_PORT=587
HEALTH_SMTP_USER=monitor@example.com
HEALTH_SMTP_PASSWORD=replace-with-an-app-password
