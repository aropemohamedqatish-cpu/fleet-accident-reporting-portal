{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Prisma generate requested",
			"type": "shell",
			"command": "node",
			"args": [
				"node_modules/prisma/build/index.js",
				"generate",
				"--schema=prisma/schema.prisma"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Capture Prisma generate streams",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const {spawnSync}=require('node:child_process'); const r=spawnSync('node',['node_modules/prisma/build/index.js','generate','--schema=prisma/schema.prisma'],{encoding:'utf8'}); process.stdout.write(JSON.stringify({stdout:r.stdout,stderr:r.stderr,exitCode:r.status},null,2)+'\\n');"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify global pnpm installation",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"--version"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect npm global pnpm install",
			"type": "shell",
			"command": "npm",
			"args": [
				"root",
				"-g"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install pinned pnpm globally",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"--global",
				"pnpm@12.3.4"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Enable pinned pnpm command",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"--global",
				"--allow-scripts=pnpm",
				"pnpm@12.3.4"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify pnpm command path",
			"type": "shell",
			"command": "C:\\Users\\MQATISH\\AppData\\Roaming\\npm\\pnpm.cmd",
			"args": [
				"--version"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Add npm global tools to user PATH",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"$npmBin = Join-Path $env:APPDATA 'npm'; $userPath = [Environment]::GetEnvironmentVariable('Path','User'); $parts = @($userPath -split ';' | Where-Object { $_ }); if (-not ($parts | Where-Object { $_.TrimEnd('\\') -ieq $npmBin.TrimEnd('\\') })) { $newPath = (@($parts) + $npmBin) -join ';'; [Environment]::SetEnvironmentVariable('Path',$newPath,'User'); Write-Output \"Added $npmBin to the user PATH. Open a new CMD window.\" } else { Write-Output \"$npmBin is already in the user PATH.\" }"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify global tools PATH",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Write-Output $env:APPDATA; [Environment]::GetEnvironmentVariable('Path','User')"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify seeded admin role safely",
			"type": "shell",
			"command": "node",
			"args": [
				"node_modules/tsx/dist/cli.mjs",
				"scripts/verify-admin-role.ts"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Review sidebar visual diff",
			"type": "shell",
			"command": "git",
			"args": [
				"diff",
				"--check",
				"--",
				"app/admin/(console)/layout.tsx",
				"components/shell/nav-links.tsx"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build dashboard sidebar refinement",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect dashboard layout changes",
			"type": "shell",
			"command": "git",
			"args": [
				"diff",
				"--",
				"app/admin/(console)/layout.tsx",
				"components/shell/nav-links.tsx"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build insured terminology updates",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run TypeScript check",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"exec",
				"tsc",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify TypeScript after fixes",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"exec",
				"tsc",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Build with TypeScript validation enabled",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}