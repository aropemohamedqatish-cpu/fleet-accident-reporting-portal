{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Prisma generate requested",
			"type": "shell",
			"command": "node",
			"args": [
				"node_modules/prisma/build/index.js",
				"generate",
				"--schema=prisma/schema.prisma"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Capture Prisma generate streams",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const {spawnSync}=require('node:child_process'); const r=spawnSync('node',['node_modules/prisma/build/index.js','generate','--schema=prisma/schema.prisma'],{encoding:'utf8'}); process.stdout.write(JSON.stringify({stdout:r.stdout,stderr:r.stderr,exitCode:r.status},null,2)+'\\n');"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}
